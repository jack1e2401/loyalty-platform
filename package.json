{
  "name": "incomsg",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/frontend",
    "apps/backend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm run dev --workspace apps/frontend",
    "dev:backend": "npm run dev --workspace apps/backend",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "test:frontend": "npm test --workspace apps/frontend",
    "test:backend": "npm test --workspace apps/backend",
    "test:db": "node scripts/test-backend-db.mjs",
    "test:e2e": "playwright test --config tests/frontend/playwright.config.ts",
    "seed": "npm run db:migrate:deploy --workspace apps/backend && npm run db:seed --workspace apps/backend && npm run db:seed:demo --workspace apps/backend"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
